  "scopes": ["onboarding:applicant", "onboarding:reviewer"],
  "events": [
    { "name": "onboarding.application.submitted", "schema": "v1" },
    { "name": "onboarding.application.approved", "schema": "v1" },
    { "name": "onboarding.application.rejected", "schema": "v1" }
  ],
  "navigation": [],
  "api": { "openapi": "Http/openapi.yaml", "basePath": "/api/v1/onboarding" }
}
