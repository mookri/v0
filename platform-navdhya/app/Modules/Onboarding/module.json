{
  "code": "onboarding",
  "name": "Partner Onboarding",
  "version": "1.0.0",
  "phase": 1,
  "priority": 100,
  "dependencies": [],
  "actions": ["submit", "review"],
  "permissions": [
    { "code": "onboarding:application:create", "name": "Start applications" },
    { "code": "onboarding:application:view", "name": "View applications" },
