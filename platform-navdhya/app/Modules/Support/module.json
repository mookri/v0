    { "code": "support:case:resolve", "name": "Resolve and close support cases with recorded remedy", "sensitive": true },
    { "code": "support:appeal:decide", "name": "Decide independent support case appeals", "sensitive": true },
    { "code": "support:grievance:manage", "name": "Manage statutory grievance clocks, decisions and NCH referrals", "sensitive": true },
    { "code": "support:refund:request", "name": "Submit and approve support refund requests to Finance", "sensitive": true },
    { "code": "support:safety_case:access", "name": "Access restricted safety cases and confidential threads", "sensitive": true },
    { "code": "support:improvement:manage", "name": "Manage provider improvement plans", "sensitive": true }
