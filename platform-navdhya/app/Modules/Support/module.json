    { "name": "support.case.acknowledged", "schema": "v1" },
    { "name": "support.case.resolved", "schema": "v1" },
    { "name": "support.case.reopened", "schema": "v1" },
    { "name": "support.grievance.copy_issued", "schema": "v1" },
    { "name": "support.grievance.breached", "schema": "v1" },
    { "name": "support.refund.requested", "schema": "v1" },
    { "name": "support.refund.breached", "schema": "v1" },
    { "name": "support.safety_case.escalated", "schema": "v1" }
  ],
  "navigation": [],
  "api": { "openapi": "Http/openapi.yaml", "basePath": "/api/v1/support" }
