APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# OTP everywhere: MSG91 widget (custom-SDK mode). Codes are delivered
# and judged by MSG91 in the browser; Laravel only verifies the JWT the
# widget hands back (POST /api/v5/widget/verifyAccessToken).
# MSG91_AUTH_KEY: server-only secret from the MSG91 dashboard. Required --
# boot fails closed without it (the msg91_widget provider cannot verify).
MSG91_AUTH_KEY=
# Widget credentials: public-by-design (MSG91 serves them on every page
# that renders the widget); also exposed to clients via GET auth/otp/config.
MSG91_WIDGET_ID=
MSG91_WIDGET_TOKEN_AUTH=
# Verify endpoint base (control.msg91.com); override only for e2e stubs.
# MSG91_VERIFY_BASE_URL=https://control.msg91.com
# Resend channel rotation (11=SMS, 4=voice, 3=email, 12=WhatsApp).
# MSG91_RESEND_CHANNELS=11,4
VITE_APP_NAME="${APP_NAME}"
# Navdhya hybrid tenancy (doc 02 §2.3).
# DB_CONNECTION=central is the Laravel default (central tables).
DB_CONNECTION=central

# Central connection (identity, authz, token-platform, platform-registry)
CENTRAL_DB_DRIVER=sqlite
CENTRAL_DB_DATABASE=database/central.sqlite
# For MySQL 8 production:
# CENTRAL_DB_DRIVER=mysql
# CENTRAL_DB_HOST=127.0.0.1
# CENTRAL_DB_PORT=3306
# CENTRAL_DB_DATABASE=navdhya_central
# CENTRAL_DB_USERNAME=root
# CENTRAL_DB_PASSWORD=

# Tenant shared-data connection (all row-level "shared" tenants)
TENANT_DB_DRIVER=sqlite
TENANT_DB_DATABASE=database/tenant_shared.sqlite
# For MySQL 8 production:
# TENANT_DB_DRIVER=mysql
# TENANT_DB_HOST=127.0.0.1
# TENANT_DB_PORT=3306
# TENANT_DB_DATABASE=navdhya_tenant_shared
# TENANT_DB_USERNAME=root
# TENANT_DB_PASSWORD=

# Payments (B3 checkout) — test-mode Razorpay by default; "fake" driver
# mints order_fake_* ids offline for tests/E2E. Webhook verification is
# live under BOTH drivers.
PAYMENTS_DRIVER=razorpay
PAYMENTS_TEST_MODE=true
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_API_BASE=https://api.razorpay.com/v1
