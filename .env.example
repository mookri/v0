APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Phone OTP via Firebase Identity Toolkit (docs/04-security/firebase-phone-otp-spike.md).
# Audience selection stays OUT of .env in every environment that runs the test
# suites — suites load .env, so OTP_PROVIDER_CUSTOMER=firebase here would aim
# every test at live Google. Pass it as process/secret-manager env instead.
# OTP_PROVIDER_CUSTOMER=firebase
# FIREBASE_CUSTOMER_PROJECT=
# FIREBASE_CUSTOMER_API_KEY=
# Must be the Phone provider's OWN reCAPTCHA site key. The key returned by
# GET /v1/recaptchaParams is a general project key: real-number sends reject
# its tokens with INVALID_APP_CREDENTIAL (spike doc RCA, 2026-10-13).
# FIREBASE_CUSTOMER_RECAPTCHA_KEY=
# Optional admin credential for the Admin SDK idToken cross-check (spike L6).
# Send/verify need only the API key above, so unset is the supported state.
# Give it an ABSOLUTE path to the key file -- storage/app/private/ is
# gitignored, so the secret itself can never be staged -- or the JSON inline
# from a secret manager. Validated at boot and must match
# FIREBASE_CUSTOMER_PROJECT: unreadable, undecodable, or cross-project
# credentials fail closed rather than registering a provider whose security
# control quietly does not exist. Never put key contents in this file.
# FIREBASE_CUSTOMER_SERVICE_ACCOUNT=
# Attestation guard for remote sends. Must be true before real numbers go
# live -- with it off an app-path send carries no attestation at all, which
# Google answers with an opaque 500. Set it as process env, never here:
# suites load .env and every firebase-provider test would then demand a
# captcha_token. Tokens must be minted from a domain in Firebase Auth
# authorized domains -- localhost-minted tokens fail the phone auth captcha
# check (CAPTCHA_CHECK_FAILED).
# OTP_CAPTCHA_REQUIRED_CUSTOMER=true
# Console test numbers: no SMS, no cost, no captcha validation.
# FIREBASE_TEST_PHONE=
# FIREBASE_TEST_CODE=

VITE_APP_NAME="${APP_NAME}"
# Navdhya hybrid tenancy (doc 02 §2.3).
# DB_CONNECTION=central is the Laravel default (central tables).
DB_CONNECTION=central

# Central connection (identity, authz, token-platform, platform-registry)
CENTRAL_DB_DRIVER=sqlite
CENTRAL_DB_DATABASE=database/central.sqlite
# For MySQL 8 production:
# CENTRAL_DB_DRIVER=mysql
# CENTRAL_DB_HOST=127.0.0.1
# CENTRAL_DB_PORT=3306
# CENTRAL_DB_DATABASE=navdhya_central
# CENTRAL_DB_USERNAME=root
# CENTRAL_DB_PASSWORD=

# Tenant shared-data connection (all row-level "shared" tenants)
TENANT_DB_DRIVER=sqlite
TENANT_DB_DATABASE=database/tenant_shared.sqlite
# For MySQL 8 production:
# TENANT_DB_DRIVER=mysql
# TENANT_DB_HOST=127.0.0.1
# TENANT_DB_PORT=3306
# TENANT_DB_DATABASE=navdhya_tenant_shared
# TENANT_DB_USERNAME=root
# TENANT_DB_PASSWORD=

# Payments (B3 checkout) — test-mode Razorpay by default; "fake" driver
# mints order_fake_* ids offline for tests/E2E. Webhook verification is
# live under BOTH drivers.
PAYMENTS_DRIVER=razorpay
PAYMENTS_TEST_MODE=true
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_API_BASE=https://api.razorpay.com/v1
