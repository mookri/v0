# ─── Navdhya Signals (B0 env contract) ──────────────────────────────────────
# See docs/analytics/signals-platform-plan.md. Values are per-surface:
# <SURFACE> ∈ WEB | CUSTOMER | PARTNER | DASHBOARD.

# GA4 measurement IDs (public — safe on the client).
NEXT_PUBLIC_GA4_MEASUREMENT_ID_WEB=
NEXT_PUBLIC_GA4_MEASUREMENT_ID_CUSTOMER=
NEXT_PUBLIC_GA4_MEASUREMENT_ID_PARTNER=
NEXT_PUBLIC_GA4_MEASUREMENT_ID_DASHBOARD=

# Google Tag Manager web containers (public — safe on the client).
# Web surface only by default; privileged surfaces get no marketing tags.
NEXT_PUBLIC_GTM_CONTAINER_ID_WEB=

# First-party collector (Signals SDK).
# B3a: same-origin Vercel Edge Function, e.g. /api/ae/v1/batch.
NEXT_PUBLIC_SIGNALS_COLLECTOR_URL=/api/ae/v1/batch
# Global kill switch — default OFF until B3 shadow validation passes.
NEXT_PUBLIC_SIGNALS_ENABLED=false

# Server-only secrets. Never NEXT_PUBLIC_. Rotate per the B7 key-rotation plan.
# HMAC secret for collector → ingestion service-to-service authentication
# (rotated secret + timestamp + nonce replay window; WIF is unavailable to edge runtimes).
SIGNALS_HMAC_SECRET=
# HMAC secret for per-batch consent tokens (server issues, edge verifies).
SIGNALS_CONSENT_TOKEN_SECRET=
# Ingestion service endpoint the collector forwards to (plan B3a).
# e.g. https://ingestion-xxxx.run.app/ingest — same-origin edge function → Cloud Run.
SIGNALS_INGEST_URL=

# GA4 / Firebase console IDs recorded here when provisioned (B0).
# Firebase web app IDs per surface: FIREBASE_APP_ID_WEB= (etc.)


# ---- B7 privacy erasure CLI (ops-level; see docs/analytics/retention-matrix.md) ----
# Only needed for `npx tsx tooling/scripts/privacy-erasure.ts --live`.
# Dry-run (the default) needs none of these; --live pre-flights the whole
# target set and refuses to run when any required value is missing.
# SIGNALS_BQ_PROJECT=                 # GCP project hosting signals_raw (BigQuery DELETEs)
# SIGNALS_BQ_MAX_BYTES_BILLED=10737418240  # erasure cost cap in bytes (default 10 GiB)
# GA4_PROPERTY_ID=                    # GA4 property for properties.deleteUserdata
# GA4_ACCESS_TOKEN=                   # OAuth token with GA4 edit permission (minted externally)
# DATABASE_URL=                       # Postgres: identity_mapping purge + privacy tables (erasure_tokens, consent_withdrawals, deletion_audit)
# SIGNALS_CACHE_PURGE_URL=            # cached-projection purge endpoint
# SIGNALS_AUDIENCE_URL=               # FCM/audience removal endpoint
# SIGNALS_AUDIENCE_TOKEN=             # bearer token for the audience endpoint (optional)
