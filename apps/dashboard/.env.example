# Local development defaults to mock mode. Copy to .env.local only when wiring real services.
#
# Backend selection: "laravel" enables the wired BFF; unset = mock mode.
# The dashboard reads DASHBOARD_API_BASE for direct mode and DASHBOARD_AUTH_*
# for federation.
DASHBOARD_API_BASE=
# OIDC federation (optional; DASHBOARD_AUTH_MODE=direct by default).
DASHBOARD_AUTH_MODE=
DASHBOARD_AUTH_ISSUER=
DASHBOARD_AUTH_CLIENT_ID=
DASHBOARD_AUTH_CLIENT_SECRET=
# RFC 9126 pushed authorization requests: off | required.
DASHBOARD_AUTH_PAR=
# Force Secure cookies when terminating TLS in development.
SESSION_COOKIE_SECURE=
