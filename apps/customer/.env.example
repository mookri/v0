# Double-submit CSRF cookie secret (dev value is fine locally).
CSRF_SECRET=

# ---- Firebase phone login (S50 kit: SDK sends/verifies, Laravel stays authoritative) ----
# Dormant until the flag is true; the legacy OTP path keeps running.
NEXT_PUBLIC_FIREBASE_LOGIN=false
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional reCAPTCHA site key (defaults to the project's console key).
NEXT_PUBLIC_FIREBASE_RECAPTCHA_KEY=

# Laravel backend wiring (mirrors the web console).
CUSTOMER_BACKEND=
NAVDHYA_API_BASE=
CUSTOMER_TENANT_ID=
