# Local development does not require any of these; the app defaults to
# mock mode. Copy to .env.local only when wiring real services.
#
# CSRF: customer mutations are protected by the HttpOnly, SameSite=Lax
# session cookie; no double-submit token is issued. If the cookie policy
# is relaxed for cross-site embedding, add a CSRF token first.

# Backend selection: "laravel" enables the wired BFF; unset = mock mode.
CUSTOMER_BACKEND=
# Laravel API origin (no trailing slash), e.g. http://localhost:8000/api/v1
NAVDHYA_API_BASE=
# Tenant ULID used for tenant-scoped backend calls.
CUSTOMER_TENANT_ID=

# Session cookie signing key. Must equal the backend IDENTITY_HMAC_SECRET
# in wired deployments. Required when NODE_ENV=production with
# CUSTOMER_BACKEND=laravel; generate with `openssl rand -base64 32`.
SESSION_SIGNING_KEY=

# OIDC federation (optional; CUSTOMER_AUTH_MODE=direct by default).
CUSTOMER_AUTH_MODE=
CUSTOMER_AUTH_ISSUER=
CUSTOMER_AUTH_CLIENT_ID=
CUSTOMER_AUTH_CLIENT_SECRET=
# RFC 9126 pushed authorization requests: off | required.
CUSTOMER_AUTH_PAR=
# DPoP private-key file for federated token binding.
CUSTOMER_DPOP_KEY_FILE=
# Force Secure cookies when terminating TLS in development.
SESSION_COOKIE_SECURE=
# Dev-only mock session (never set in production).
DEV_CUSTOMER_SESSION=
