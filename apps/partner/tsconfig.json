{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@navdhya/otp": [
        "../../packages/otp/src/index.ts"
      ],
      "@navdhya/otp/widget": [
        "../../packages/otp/src/widget/loader.ts"
      ],
      "@navdhya/otp/client": [
        "../../packages/otp/src/client.ts"
      ],
      "@navdhya/otp/resend": [
        "../../packages/otp/src/resend.ts"
      ],
      "@navdhya/otp/schemas": [
        "../../packages/otp/src/schemas.ts"
      ],
      "@navdhya/otp/*": [
        "../../packages/otp/src/*"
      ],
      "@navdhya/api-client": [
        "../../packages/api-client/src/index.ts"
      ],
      "@navdhya/auth-client": [
        "../../packages/auth-client/src/index.ts"
      ],
      "@navdhya/contracts": [
        "../../packages/contracts/src/index.ts"
      ],
      "@navdhya/*": [
        "../../packages/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}