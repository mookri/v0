# Local development defaults to mock mode. Copy to .env.local only when wiring real services.
#
# Backend selection: "laravel" enables the wired BFF; unset = mock mode.
PARTNER_BACKEND=
# Laravel API origin only (no trailing slash, no /api/v1 — the BFF appends
# /api/v1), e.g. http://localhost:8000
NAVDHYA_API_BASE=
# Tenant ULID used for tenant-scoped backend calls.
PARTNER_TENANT_ID=
# Session cookie signing key. Must equal the backend IDENTITY_HMAC_SECRET
# in wired deployments. Required when NODE_ENV=production with
# PARTNER_BACKEND=laravel; generate with `openssl rand -base64 32`.
SESSION_SIGNING_KEY=
# Force Secure cookies when terminating TLS in development.
SESSION_COOKIE_SECURE=

# OIDC federation (optional; PARTNER_AUTH_MODE=direct by default).
PARTNER_AUTH_MODE=
PARTNER_AUTH_ISSUER=
PARTNER_AUTH_CLIENT_ID=
PARTNER_AUTH_CLIENT_SECRET=
# RFC 9126 pushed authorization requests: off | required.
PARTNER_AUTH_PAR=
