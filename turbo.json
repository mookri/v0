{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV", "CI", "SEO_CONTENT_SOURCE", "CUSTOMER_BACKEND"],
  "boundaries": {
    "tags": {
      "app:web": {
        "dependencies": {
          "deny": ["app:customer", "app:partner", "app:dashboard"]
        }
      },
      "app:customer": {
        "dependencies": {
          "deny": ["app:web", "app:partner", "app:dashboard"]
        }
      },
      "app:partner": {
        "dependencies": {
          "deny": ["app:web", "app:customer", "app:dashboard"]
        }
      },
      "app:dashboard": {
        "dependencies": {
          "deny": ["app:web", "app:customer", "app:partner"]
        }
      },
      "pkg:shared": {
        "dependencies": {
          "deny": ["app:web", "app:customer", "app:partner", "app:dashboard"]
        }
      }
    }
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!**/*.spec.*", "!**/*.test.*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "contract": {
      "dependsOn": ["^build"],
      "outputs": ["src/generated/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
