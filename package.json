{
  "name": "navdhya",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "sync:registry": "npx tsx scripts/rebuild-content-registry.ts",
    "seo:normalize": "npx tsx scripts/normalize-seo-catalog.ts",
    "seo:bootstrap": "npx tsx scripts/implement-seo-completion.ts && npm run seo:normalize",
    "seo:generate": "npx tsx scripts/generate-seo-v2.ts && npm run sync:registry && npm run seo:normalize",
    "seo:qa": "npx tsx scripts/qa-seo-v2.ts",
    "seo:audit": "npm run seo:qa && npx tsx scripts/audit-seo.ts",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "generate-sitemap:file": "npx tsx script/generate-full-sitemap.ts",
    "secrets:scan": "gitleaks protect --staged --redact --config .gitleaks.toml --verbose",
    "secrets:scan:all": "gitleaks detect --redact --config .gitleaks.toml --verbose",
    "secrets:baseline": "detect-secrets-scan --create-baseline .secrets.baseline",
    "secrets:check": "detect-secrets-scan --baseline .secrets.baseline",
    "i18n:translate": "npx tsx scripts/translate.ts",
    "i18n:check": "npx tsx scripts/check-bundle-parity.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "latest",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-dropdown-menu": "latest",
    "@radix-ui/react-label": "latest",
    "@radix-ui/react-select": "latest",
    "@radix-ui/react-separator": "latest",
    "@radix-ui/react-slot": "latest",
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "commander": "^14.0.2",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.1",
    "framer-motion": "^12.23.24",
    "geist": "^1.3.1",
    "glob": "^11.0.0",
    "input-otp": "1.4.1",
    "lucide-react": "^0.454.0",
    "next": "16.0.10",
    "posthog-js": "^1.200.0",
    "react": "^19",
    "react-day-picker": "9.8.0",
    "react-dom": "^19",
    "react-hook-form": "^7.60.0",
    "react-icons": "^5.5.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "2.15.4",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.9",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.10.32",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.3.0",
    "postcss": "^8.5",
    "tailwindcss": "^4.1.9",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.1",
    "turbo": "^2.11.5",
    "tw-animate-css": "1.3.3",
    "typescript": "^5"
  },
  "engines": {
    "node": "20.x",
    "pnpm": "9.15.4"
  }
}
